{
  "manifest_version": 3,
  "name": "BDO Inquiry Autofill",
  "version": "1.3.0",
  "description": "Save your contact details locally and fill the BDO vehicle inquiry form on demand.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BDO Inquiry Autofill"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bdo.com.ph/personal/assets-for-sale/vehicles/results-page*",
        "https://bdo.com.ph/personal/assets-for-sale/vehicles/results-page*"
      ],
      "js": ["results.js"],
      "run_at": "document_idle"
    }
  ]
}
